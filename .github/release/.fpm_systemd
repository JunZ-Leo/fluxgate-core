-s dir
--name fluxgate
--category net
--license GPL-3.0-or-later
--description "Fluxgate Core, a compatibility-first proxy core."
--url "https://github.com/JunZ-Leo/fluxgate-core"
--maintainer "Fluxgate Core contributors"
--deb-field "Bug: https://github.com/JunZ-Leo/fluxgate-core/issues"
--no-deb-generate-changes
--config-files /etc/fluxgate/config.yaml

.github/release/config.yaml=/etc/fluxgate/config.yaml

.github/release/fluxgate.service=/usr/lib/systemd/system/fluxgate.service
.github/release/fluxgate@.service=/usr/lib/systemd/system/fluxgate@.service


LICENSE=/usr/share/licenses/fluxgate/LICENSE
NOTICE=/usr/share/licenses/fluxgate/NOTICE